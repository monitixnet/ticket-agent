{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ticket-agent-segerstrom",
	"main": "index.js",
	"compatibility_date": "2026-07-30",
	"vars": {
		"WORKER_VENUE_ID": "segerstrom_center"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *",
			"7,17,27,37,47,57 * * * *",
			"12,32,52 * * * *",
			"3 * * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
		"binding": "DB",
		"database_name": "ticket-agent-db",
		"database_id": "e7ab586a-98d6-46ad-9e08-8748272573f8",
		"migrations_dir": "migrations"
		}
	]
}
