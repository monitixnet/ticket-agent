{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ticket-agent-segerstrom",
	"main": "index.js",
	"compatibility_date": "2026-07-30",
	"vars": {
		"ALLOW_SKYBOX_LISTING": "false",
		"API_FETCH_PROVIDER_POOL": "native",
		"DISCOVERY_MAX_PAGES": "30",
		"ENABLE_AUTOMATED_APPROVAL": "false",
		"ENABLE_DEBUG_NOTIFICATIONS": "true",
		"FETCH_PROVIDER_POOL": "native",
		"SKYBOX_API_GATEWAY_URL": "https://skybox.com",
		"WORKER_VENUE_ID": "segerstrom_center"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *",
			"7,17,27,37,47,57 * * * *",
			"12,32,52 * * * *",
			"3-58/5 * * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
		"binding": "DB",
		"database_name": "ticket-agent-db",
		"database_id": "e7ab586a-98d6-46ad-9e08-8748272573f8",
		"migrations_dir": "migrations"
		}
	]
}
