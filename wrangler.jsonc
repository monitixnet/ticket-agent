{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ticket-agent",
	"main": "index.js",
	"compatibility_date": "2026-07-30",
	"triggers": {
		"crons": [
			"*/5 * * * *",
			"9,29,59 * * * *",
			"17,27,57 * * * *",
			"7,37 * * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
		"binding": "DB",
		"database_name": "ticket-agent-db",
		"database_id": "e7ab586a-98d6-46ad-9e08-8748272573f8",
		"migrations_dir": "migrations"
		}
	]
}
